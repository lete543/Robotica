// Código inicial de um segue faixa usando controle básico
// Variáveis de tempo para controle de amostragem (atualmente desativadas)
//unsigned long int ta = 0;
//unsigned long int t = 0;

int ea = 0; // Armazena o erro anterior para o cálculo do termo derivativo

// Parâmetros de ganho do controlador PID
float Kp = 1.4; // Ganho Proporcional: atua diretamente no erro atual
float Kd = 1.3; // Ganho Derivativo: atua na taxa de variação do erro (suaviza oscilações)
float Ki = 0.1; // Ganho Integral: atua no acúmulo de erro ao longo do tempo

// Leitura individual de cada um dos 5 sensores seguidores de linha
int see = 0; // Sensor Extremamente Esquerdo
int sei = 0; // Sensor Esquerdo Interno
int sdi = 0; // Sensor Direito Interno
int sde = 0; // Sensor Extremamente Direito
int sfi = 0; // Sensor Frontal/Central Interno

// Mapeamento antigo de pinos dos motores (mantido como referência)
//#define md1 5
//#define md2 6
//#define me1 7
//#define me2 8

// Mapeamento dos pinos de controle dos motores na ponte H
#define me1 6 // Motor Esquerdo - Direção/PWM 1
#define me2 5 // Motor Esquerdo - Direção/PWM 2
#define md1 7 // Motor Direito - Direção/PWM 1
#define md2 8 // Motor Direito - Direção/PWM 2

void setup() {
  // Inicialização da comunicação serial para depuração (desativada)
  // Serial.begin(9600);
  // delay(50);

  // Configuração dos pinos dos sensores analógicos como entradas
  pinMode(A8, INPUT);
  pinMode(A9, INPUT);
  pinMode(A10, INPUT);
  pinMode(A11, INPUT);
  pinMode(A12, INPUT);

  // Configuração dos pinos da ponte H como saídas para os motores
  pinMode(md1, OUTPUT);
  pinMode(md2, OUTPUT);
  pinMode(me1, OUTPUT);
  pinMode(me2, OUTPUT);
}

void loop() {
  // Leitura contínua dos valores analógicos de cada sensor de linha
  sde = analogRead(A8); // Leitura do sensor extremamente direito
  sdi = analogRead(A9); // Leitura do sensor direito interno
  sfi = analogRead(A10); // Leitura do sensor central/frente
  sei = analogRead(A11); // Leitura do sensor esquerdo interno
  see = analogRead(A12); // Leitura do sensor extremamente esquerdo

  // Ordem alternativa de mapeamento de pinos dos sensores (desativada)
  // see = analogRead(A8);
  // sei = analogRead(A9);
  // sfi = analogRead(A10);
  // sdi = analogRead(A11);
  // sde = analogRead(A12);

  // Executa o algoritmo de controle PID
  PD();
}

void PD() {
  static float I = 0; // Variável estática para acumular o erro ao longo do tempo (termo Integral)

  // Cálculo da média ponderada para ponderar o peso dos sensores da direita e esquerda
  int md, me;
  me = ((sdi * 2) + (sde * 3)) / 5; // Ponderação do lado direito
  md = ((sei * 2) + (see * 3)) / 5; // Ponderação do lado esquerdo
  int e = md - me; // Cálculo do erro de alinhamento em relação à linha

  // Cálculo do tempo decorrido para ajuste do tempo real (desativado)
  // ta = (millis() - t) / 1000;
  // t = millis();

  // Limitação simples para o acúmulo do termo integral (Anti-windup)
  if (I > abs(100)) {
    I = I; // Mantém o valor atual de I se exceder o limite de 100
  }
  else {
    I += e; // Acumula o erro atual ao termo integral
  }

  // Cálculo da componente Derivativa considerando a diferença do erro atual e do anterior
  // float D = (float)(e - ea) / (t - ta) * Kd;
  float D = (e - ea);

  // Cálculo do sinal de controle final U somando as componentes P, I e D
  float U = (e * Kp) + (I * Ki) + (D * Kd);
  // float U = P + D;

  // Trava o sinal de controle dentro dos limites máximo de 450 e mínimo de -450
  if (U > 450) U = 450;
  if (U < -450) U = -450;

  // Ajusta proporcionalmente as velocidades dos motores conforme o sinal de controle U
  if (U > 0) andar(255 - U, 255); // Reduz a velocidade da esquerda se o sinal for positivo
  else andar(255, 255 + U);      // Reduz a velocidade da direita se o sinal for negativo

  ea = e; // Atualiza o erro anterior com o erro atual para a próxima iteração

  // Monitoramento do erro e sinal de controle pela porta serial (desativado)
  // Serial.print(e);
  // Serial.print(" ");
  // Serial.println(U);
}

// Função de acionamento dos motores com controle de velocidade e sentido
void andar(int esq, int dir) {
  // Controle do motor do lado esquerdo
  // Se a velocidade requisitada for menor que 0, inverte o sentido de rotação
  if (esq < 0) {
    digitalWrite(me1, 0);
    analogWrite(me2, esq); // Aplica a rotação inversa no motor esquerdo
  }
  else {
    analogWrite(me1, esq); // Aplica a velocidade para frente no motor esquerdo
    digitalWrite(me2, 0);
  }

  // Controle do motor do lado direito
  // Se a velocidade requisitada for menor que 0, inverte o sentido de rotação
  if (dir < 0) {
    digitalWrite(md1, 0);
    analogWrite(md2, dir); // Aplica a rotação inversa no motor direito
  }
  // Se a velocidade for maior ou igual a 0, aciona para frente
  else {
    analogWrite(md1, dir); // Aplica a velocidade para frente no motor direito
    digitalWrite(md2, 0);
  }
}
